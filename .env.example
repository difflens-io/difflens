# Optional analytics. Leave empty to disable analytics in local builds.
VITE_GA_MEASUREMENT_ID=
VITE_BAIDU_SITE_ID=

# Optional comma-separated host allowlist for analytics.
# Example: difflens.io,www.difflens.io
VITE_ANALYTICS_HOSTS=

# Optional static deploy target for scripts/deploy-static.sh.
DIFFLENS_DEPLOY_TARGET=
